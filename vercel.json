{
  "framework": "vite",
  "buildCommand": "npm run build:hosted",
  "outputDirectory": "dist",
  "functions": { "api/catalog-page.js": { "includeFiles": "dist/store/index.html" } },
  "rewrites": [
    { "source": "/repair", "destination": "/repair/index.html" },
    { "source": "/web-software", "destination": "/web-software/index.html" },
    { "source": "/store", "destination": "/store/index.html" },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/store/:slug",
      "destination": "/api/catalog-page?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
